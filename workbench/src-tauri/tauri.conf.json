{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonance Workbench",
  "version": "0.7.0",
  "identifier": "com.resonance.workbench",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resonance Workbench",
        "width": 1680,
        "height": 1040,
        "minWidth": 1100,
        "minHeight": 740,
        "backgroundColor": "#111518"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../worker/bridge.py": "bridge.py"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
