{
  "name": "resonance-workbench",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tauri dev",
    "web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build --config src-tauri/tauri.bundle.conf.json --no-bundle",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:authoring": "node scripts/run-authoring.mjs",
    "test:visual": "node scripts/run-visual.mjs",
    "test:pools": "node scripts/run-pools.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "diff": "8.0.4",
    "jsonc-parser": "3.3.1",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
